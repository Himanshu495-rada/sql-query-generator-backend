
# Application settings
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database connection for the application
DATABASE_URL="postgres://postgres:root@localhost:5432/backend"

# JWT Authentication
JWT_SECRET=
TOKEN_EXPIRATION=8h


# Azure OpenAI Configuration
USE_AZURE_OPENAI=true
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_MODEL_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-04-01-preview

# Sandbox settings
SANDBOX_DB_PREFIX=
SANDBOX_DB_HOST=
SANDBOX_DB_PORT=
SANDBOX_DB_USER=
SANDBOX_DB_PASSWORD=

# Sample database credentials (optional)
SAMPLE_DB_HOST=
SAMPLE_DB_PORT=
SAMPLE_DB_USER=
SAMPLE_DB_PASSWORD=
SAMPLE_DB_NAME=