
# Application settings
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database connection for the application
DATABASE_URL="postgres://postgres:root@localhost:5432/backend"

# JWT Authentication
JWT_SECRET=helloworld
TOKEN_EXPIRATION=8h

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here

# Sandbox settings
SANDBOX_DB_PREFIX=sandbox_
SANDBOX_DB_HOST=localhost
SANDBOX_DB_PORT=5432
SANDBOX_DB_USER=sandbox_user
SANDBOX_DB_PASSWORD=sandbox_password

# Sample database credentials (optional)
SAMPLE_DB_HOST=localhost
SAMPLE_DB_PORT=5432
SAMPLE_DB_USER=sample_user
SAMPLE_DB_PASSWORD=sample_password
SAMPLE_DB_NAME=sample_db